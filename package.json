{
  "name": "obsidian-git-history",
  "version": "1.3.0",
  "description": "Git History for Obsidian – Full Git management with an intuitive UI and commit graph",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "lint": "eslint src/ --max-warnings 0",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"styles.css\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"styles.css\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "wdio run ./wdio.conf.mts",
    "validate": "npm run typecheck && npm run lint && npm run lint:review && npm run lint:css && npm run format:check && npm run test && npm run build",
    "prepare": "husky",
    "lint:css": "stylelint styles.css",
    "lint:review": "eslint src/ --config eslint.review.config.mjs --max-warnings 0"
  },
  "keywords": [
    "obsidian",
    "git",
    "version-control",
    "history",
    "graph"
  ],
  "author": "chrisurf",
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.11.0",
    "@wdio/cli": "^9.30.0",
    "@wdio/globals": "^9.29.1",
    "@wdio/local-runner": "^9.30.0",
    "@wdio/mocha-framework": "^9.30.0",
    "@wdio/spec-reporter": "^9.29.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "happy-dom": "^20.11.0",
    "husky": "^9.1.7",
    "nano-staged": "^1.0.2",
    "obsidian": "^1.7.2",
    "obsidian-launcher": "^3.1.1",
    "prettier": "^3.9.5",
    "semantic-release": "^25.0.8",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^39.0.1",
    "tslib": "^2.6.0",
    "tsx": "^4.23.1",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10",
    "wdio-obsidian-reporter": "^3.1.1",
    "wdio-obsidian-service": "^3.1.1"
  },
  "overrides": {
    "conventional-commits-filter": "^6.0.1"
  },
  "nano-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "tests/**/*.ts": [
      "prettier --write"
    ],
    "styles.css": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/xterm": "^6.0.0"
  }
}
